# Copy this file next to backup-to-telegram.sh and fill in values.
# Do not commit real tokens or passwords to version control.

# Docker image only: 5-field crontab schedule (UTC). Read by docker-entrypoint.sh (safe without quotes).
# CRON_SCHEDULE=0 2 * * *
# You may also use: CRON_SCHEDULE="0 2 * * *"

# Telegram Bot API (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where compressed dumps are written before upload
BACKUP_DIR=/tmp/pg-telegram-backups

# Comma-separated targets: CONTAINER_NAME:DATABASE_NAME:POSTGRES_ROLE
# The third value is a PostgreSQL login role inside the DB (often "postgres"), not your app password.
# Example:
# BACKUP_TARGETS=myapp_db:myapp:postgres,api_db:api_production:postgres
BACKUP_TARGETS=

# If your containers need a password for pg_dump, set it (same for all targets).
# Leave empty when trust / socket auth works inside the container (common for local docker exec).
POSTGRES_PASSWORD=

# Optional: absolute path to pg_dump inside the DB container if you still get exit 126 (Bitnami, custom images).
# PG_DUMP_PATH=/opt/bitnami/postgresql/bin/pg_dump

# Remove local .sql.gz after a successful Telegram upload (true/false)
DELETE_LOCAL_AFTER_SEND=true
